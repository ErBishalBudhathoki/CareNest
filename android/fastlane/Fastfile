# This file contains the fastlane configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  def project_root
    File.expand_path("../..", __dir__)
  end

  def android_root
    File.join(project_root, "android")
  end

  def production_aab_relative_path
    File.join("..", "build", "app", "outputs", "bundle",
      "productionRelease", "app-production-release.aab")
  end

  def production_aab_absolute_path
    File.expand_path(production_aab_relative_path, android_root)
  end

  def load_flutter_properties
    properties = {}

    properties["flutter.versionName"] = ENV["VERSION_NAME"] if ENV["VERSION_NAME"] && !ENV["VERSION_NAME"].empty?
    properties["flutter.versionCode"] = ENV["VERSION_CODE"] if ENV["VERSION_CODE"] && !ENV["VERSION_CODE"].empty?

    properties_file = File.join(project_root, "android", "local.properties")
    if File.exist?(properties_file)
      File.readlines(properties_file).each do |line|
        key, value = line.strip.split('=', 2)
        properties[key] = value if key && value
      end
    end

    properties
  end

  def ensure_changelog(version_name, version_code, default_message)
    release_notes_file = File.join(project_root, "android",
      "release_notes_#{version_name}.txt")

    if File.exist?(release_notes_file)
      UI.message "Found release notes file: #{release_notes_file}"
      release_notes = File.read(release_notes_file)
    else
      UI.message "Release notes file not found at #{release_notes_file}, using default."
      release_notes = default_message
    end

    metadata_dir = File.join(__dir__, "metadata", "android", "en-US")
    changelog_dir = File.join(metadata_dir, "changelogs")
    FileUtils.mkdir_p(changelog_dir)
    File.write(File.join(changelog_dir, "#{version_code}.txt"), release_notes)
  end

  desc "Increment version code"
  lane :increment_version_code do
    # Read current version from local.properties
    properties_file = "../local.properties"
    properties = {}
    
    if File.exist?(properties_file)
      File.readlines(properties_file).each do |line|
        key, value = line.strip.split('=', 2)
        properties[key] = value if key && value
      end
    end
    
    current_version_code = (properties['flutter.versionCode'] || '1').to_i
    new_version_code = current_version_code + 1
    
    # Update version code in local.properties
    updated_content = []
    version_code_updated = false
    
    if File.exist?(properties_file)
      File.readlines(properties_file).each do |line|
        if line.start_with?('flutter.versionCode=')
          updated_content << "flutter.versionCode=#{new_version_code}\n"
          version_code_updated = true
        else
          updated_content << line
        end
      end
    end
    
    # Add version code if it wasn't found
    unless version_code_updated
      updated_content << "flutter.versionCode=#{new_version_code}\n"
    end
    
    File.write(properties_file, updated_content.join)
    
    UI.message "Version code incremented from #{current_version_code} to #{new_version_code}"
  end

  desc "Capture screenshots for the store"
  lane :capture_screenshots do
    # Build APKs for testing (using development flavor)
    sh "cd .. && ./gradlew assembleDevelopmentDebug assembleDevelopmentDebugAndroidTest"
    
    screengrab(
      app_apk_path: "../build/app/outputs/apk/development/debug/app-development-debug.apk",
      tests_apk_path: "../build/app/outputs/apk/androidTest/development/debug/app-development-debug-androidTest.apk",
      app_package_name: "com.bishal.invoice.dev",
      locales: ["en-US"],
      clear_previous_screenshots: true
    )
  end

  desc "Deploy development build to internal testing"
  lane :deploy_development do
    # Build the production AAB (development track uses production flavor)
    sh "cd .. && flutter build appbundle --flavor production -t lib/main_production.dart --release"

    Dir.chdir(project_root) do
      upload_to_play_store(
        track: 'internal',
        package_name: 'com.bishal.invoice',
        aab: production_aab_relative_path,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end
  end

  desc "Deploy production build to production track"
  lane :deploy_production do
    # Build the production AAB
    sh "cd .. && flutter build appbundle --flavor production -t lib/main_production.dart --release"

    properties = load_flutter_properties
    version_name = properties['flutter.versionName'] || '1.0'
    version_code = properties['flutter.versionCode'] || '1'

    ensure_changelog(
      version_name,
      version_code,
      "Production release #{version_name} (#{version_code})\n\nStable release for production."
    )
    
    upload_to_play_store(
      track: 'production',
      package_name: 'com.bishal.invoice',
      aab: production_aab_relative_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Deploy internal build to internal testing"
  lane :deploy_internal do
    # Build the production AAB (internal uses production flavor)
    sh "cd .. && flutter build appbundle --flavor production -t lib/main_production.dart --release"

    Dir.chdir(project_root) do
      upload_to_play_store(
        track: 'internal',
        package_name: 'com.bishal.invoice',
        aab: production_aab_relative_path,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end
  end

  desc "Upload existing production AAB to internal testing"
  lane :upload_internal_aab do
    UI.user_error!("AAB not found at #{production_aab_relative_path}. Build it first.") unless File.exist?(production_aab_absolute_path)

    upload_to_play_store(
      track: 'internal',
      package_name: 'com.bishal.invoice',
      aab: production_aab_relative_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload existing production AAB to production track"
  lane :upload_production_aab do
    UI.user_error!("AAB not found at #{production_aab_relative_path}. Build it first.") unless File.exist?(production_aab_absolute_path)

    properties = load_flutter_properties
    version_name = properties['flutter.versionName'] || '1.0'
    version_code = properties['flutter.versionCode'] || '1'

    ensure_changelog(
      version_name,
      version_code,
      "Production release #{version_name} (#{version_code})\n\nStable release for production."
    )

    upload_to_play_store(
      track: 'production',
      package_name: 'com.bishal.invoice',
      aab: production_aab_relative_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
