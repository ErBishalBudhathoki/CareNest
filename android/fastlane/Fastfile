# This file contains the fastlane configuration
# You can find the documentation at https://docs.fastlane.tools
#
# Release contract (verified against the live Play Console on 2026-11-06):
#   * package com.bishal.invoice, production track = 158, internal track = 227
#   * pushes to main upload to INTERNAL only
#   * production is reached EXCLUSIVELY by promote_internal_to_production,
#     which promotes a version code that is already on the internal track
#     and ships the listing metadata + screenshots with it.
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  PACKAGE_NAME = "com.bishal.invoice".freeze
  PLAY_TRACKS = %w[production beta alpha internal].freeze

  def project_root
    File.expand_path("../..", __dir__)
  end

  def android_root
    File.join(project_root, "android")
  end

  def production_aab_relative_path
    File.join("..", "build", "app", "outputs", "bundle",
      "productionRelease", "app-production-release.aab")
  end

  def production_aab_absolute_path
    File.expand_path(production_aab_relative_path, android_root)
  end

  def metadata_root
    File.join(__dir__, "metadata", "android")
  end

  # CI sets VERSION_NAME / VERSION_CODE from pubspec.yaml. Those MUST win over
  # android/local.properties: that file is gitignored, is regenerated by
  # `flutter build appbundle`, and can hold a stale build number from a
  # previous local run. The original implementation let local.properties
  # overwrite the ENV values, so a CI deployment silently used a stale code.
  def load_flutter_properties
    properties = {}

    properties_file = File.join(android_root, "local.properties")
    if File.exist?(properties_file)
      File.readlines(properties_file).each do |line|
        key, value = line.strip.split('=', 2)
        properties[key] = value if key && value
      end
    end

    properties["flutter.versionName"] = ENV["VERSION_NAME"] if ENV["VERSION_NAME"] && !ENV["VERSION_NAME"].empty?
    properties["flutter.versionCode"] = ENV["VERSION_CODE"] if ENV["VERSION_CODE"] && !ENV["VERSION_CODE"].empty?

    properties
  end

  # Writes the release notes for this version into the fastlane changelogs dir.
  #
  # Notes are mandatory, including for internal testing: those builds reach real
  # testers, and a missing notes file used to fall back to an empty template, so
  # testers got a changelog full of blank bullets and no idea what to retest.
  def ensure_changelog(version_name, version_code)
    release_notes_file = File.join(project_root, "android",
      "release_notes_#{version_name}.txt")

    unless File.exist?(release_notes_file)
      UI.user_error!(<<~MSG)
        No release notes found for #{version_name} (#{version_code}).

        Expected: #{release_notes_file}

        Write that file describing what actually changed in this build, then
        re-run. Every deployment ships to testers, so this fails rather than
        publishing an empty changelog.
      MSG
    end

    release_notes = File.read(release_notes_file).strip
    if release_notes.empty?
      UI.user_error!("#{release_notes_file} is empty. Add the changes for this build.")
    end

    # Google Play rejects en-US release notes over 500 characters, and it only
    # discovers that after a slow API round trip. Fail here instead.
    max_length = 500
    if release_notes.length > max_length
      UI.user_error!(<<~MSG)
        #{release_notes_file} is #{release_notes.length} characters.
        Google Play rejects en-US release notes over #{max_length}.

        Shorten it, or move the detail into the commit message / PR.
      MSG
    end

    UI.message "Using release notes: #{release_notes_file} (#{release_notes.length} chars)"

    metadata_dir = File.join(metadata_root, "en-US")
    changelog_dir = File.join(metadata_dir, "changelogs")
    FileUtils.mkdir_p(changelog_dir)
    File.write(File.join(changelog_dir, "#{version_code}.txt"), release_notes)
  end

  # Reads every Play track and returns { track => [version codes] }.
  # Any unreadable track is a hard failure: a partial answer would let an
  # already-used version code look "new" and break the release at upload time.
  def play_track_version_codes
    PLAY_TRACKS.each_with_object({}) do |track, acc|
      begin
        codes = google_play_track_version_codes(
          package_name: PACKAGE_NAME,
          track: track,
        ) || []
        acc[track] = codes.map(&:to_i)
      rescue => e
        UI.user_error!(
          "Could not read Play track '#{track}' for #{PACKAGE_NAME}: #{e.message}. " \
          "Refusing to upload: version-code verification must be complete.",
        )
      end
    end
  end

  def png_dimensions(path)
    header = File.binread(path, 24)
    return nil unless header && header.bytesize >= 24
    return nil unless header[0, 8] == "\x89PNG\r\n\x1a\n".b
    header[16, 8].unpack("N2")
  end

  # Google Play requires 2-8 phone screenshots, 320-3840px per side, with a
  # portrait aspect ratio no taller than 2:1. Fail locally instead of letting
  # the Play API reject the promotion after a long upload.
  def verify_store_metadata!
    en_us = File.join(metadata_root, "en-US")
    %w[title.txt short_description.txt full_description.txt].each do |name|
      path = File.join(en_us, name)
      unless File.exist?(path) && !File.read(path).strip.empty?
        UI.user_error!("Missing or empty Play listing metadata: #{path}")
      end
      if name == "short_description.txt" && File.read(path).strip.length > 80
        UI.user_error!("short_description.txt exceeds Google Play's 80-character limit.")
      end
      if name == "title.txt" && File.read(path).strip.length > 30
        UI.user_error!("title.txt exceeds Google Play's 30-character limit.")
      end
      if name == "full_description.txt" && File.read(path).strip.length > 4000
        UI.user_error!("full_description.txt exceeds Google Play's 4000-character limit.")
      end
    end

    screenshots_dir = File.join(en_us, "images", "phoneScreenshots")
    # macOS APFS is case-insensitive by default: the lowercase and uppercase
    # branches of the brace expansion both match the same file, so a single
    # 8-shot set is counted as 16. De-duplicate case-insensitively before
    # enforcing Play's 2-8 screenshot limit.
    shots = Dir.glob(File.join(screenshots_dir, "*.{png,PNG,jpg,JPG,jpeg,JPEG}"))
               .uniq { |path| path.downcase }
               .sort
    if shots.length < 2 || shots.length > 8
      UI.user_error!(<<~MSG)
        Google Play requires 2-8 phone screenshots for a production release.
        Found #{shots.length} in #{screenshots_dir}.

        Add store-approved captures there (scripts/prepare_play_screenshots.sh
        normalises the local app-store captures to Play's size/aspect limits),
        then re-run the promotion.
      MSG
    end

    shots.each do |shot|
      dimensions = png_dimensions(shot)
      unless dimensions
        UI.user_error!(
          "#{File.basename(shot)} is not a readable PNG. Convert it to a 24-bit PNG (no alpha).",
        )
      end
      width, height = dimensions
      sides = [width, height]
      unless sides.min >= 320 && sides.max <= 3840
        UI.user_error!(
          "#{File.basename(shot)} is #{width}x#{height}; Play requires 320-3840px per side.",
        )
      end
      ratio = sides.max.to_f / sides.min.to_f
      if ratio > 2.0
        UI.user_error!(
          "#{File.basename(shot)} has a #{ratio.round(2)}:1 aspect ratio; " \
          "Play allows at most 2:1 for portrait screenshots.",
        )
      end
    end

    UI.success "Play listing metadata and #{shots.length} screenshots validated."
  end

  # Plain method (not a lane) so it can be reused by the upload lane without
  # relying on lane-to-lane dispatch semantics.
  def assert_version_code_higher!(candidate)
    published = play_track_version_codes
    highest = published.values.flatten.max || 0
    highest_track = published.select { |_, codes| codes.include?(highest) }.keys.first || "none"

    if candidate <= highest
      UI.user_error!(<<~MSG)
        versionCode #{candidate} is NOT strictly higher than the highest published
        versionCode #{highest} (track: #{highest_track}).

        Bump the build number in pubspec.yaml (version: <name>+<code>), commit
        it, and rebuild. Publishing a lower or equal code is rejected by Google
        Play and, worse, can leave testers on an older build than production.
      MSG
    end

    UI.success "versionCode #{candidate} > highest published #{highest} (#{highest_track})."
  end

  def required_version_code
    raw = (ENV["VERSION_CODE"] || "").strip
    UI.user_error!("VERSION_CODE is required (export it from pubspec.yaml).") if raw.empty?
    unless raw.match?(/\A\d+\z/) && raw.to_i.positive?
      UI.user_error!("VERSION_CODE must be a positive integer, got '#{raw}'.")
    end
    raw.to_i
  end

  desc "Fail unless this build's versionCode is strictly higher than every Google Play track"
  lane :verify_version_code do
    assert_version_code_higher!(required_version_code)
  end

  desc "Validate Play listing metadata and screenshots without uploading anything"
  lane :verify_store_metadata do
    verify_store_metadata!
  end

  desc "Increment the build number in pubspec.yaml (the source of truth for Flutter)"
  lane :increment_version_code do
    # The old lane wrote android/local.properties. `flutter build appbundle`
    # regenerates that file from pubspec.yaml on every run, so the increment was
    # silently discarded and the same versionCode was uploaded again.
    pubspec = File.join(project_root, "pubspec.yaml")
    UI.user_error!("pubspec.yaml not found at #{pubspec}") unless File.exist?(pubspec)

    content = File.read(pubspec)
    match = content.match(/^version:[ \t]*([^\s+]+)\+(\d+)[ \t]*$/)
    unless match
      UI.user_error!(
        "pubspec.yaml has no 'version: <name>+<code>' line. Set one before releasing.",
      )
    end

    version_name = match[1]
    current = match[2].to_i
    updated = content.sub(/^version:\s*[^\n]*$/, "version: #{version_name}+#{current + 1}")
    File.write(pubspec, updated)

    UI.message "versionCode incremented from #{current} to #{current + 1} in pubspec.yaml"
    UI.important "Commit the pubspec.yaml bump; verify_version_code reads it during deployment."
  end

  desc "Capture screenshots for the store"
  lane :capture_screenshots do
    # Build APKs for testing (using development flavor)
    sh "cd .. && ./gradlew assembleDevelopmentDebug assembleDevelopmentDebugAndroidTest"

    screengrab(
      app_apk_path: "../build/app/outputs/apk/development/debug/app-development-debug.apk",
      tests_apk_path: "../build/app/outputs/apk/androidTest/development/debug/app-development-debug-androidTest.apk",
      app_package_name: "com.bishal.invoice.dev",
      locales: ["en-US"],
      clear_previous_screenshots: true
    )
  end

  # A direct production upload bypasses internal testing. CI must never call
  # these lanes; escape hatch is an explicit, deliberate env flag.
  def assert_no_direct_production!
    return if ENV["ALLOW_DIRECT_PRODUCTION"] == "true"
    UI.user_error!(<<~MSG)
      Direct production uploads are disabled.

      Pushes to main deploy to the INTERNAL track first. After the internal
      build has been tested, run the manual `Promote to Production` workflow
      (which calls `fastlane promote_internal_to_production`). That lane
      promotes the exact tested versionCode and ships listing metadata.

      If you truly need an untested direct upload, set ALLOW_DIRECT_PRODUCTION=true.
    MSG
  end

  desc "Deploy development build to internal testing"
  lane :deploy_development do
    sh "cd .. && flutter build appbundle --flavor production -t lib/main_production.dart --release"

    upload_to_play_store(
      track: 'internal',
      package_name: PACKAGE_NAME,
      aab: production_aab_absolute_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Deploy production build to production track (DISABLED - use promote lane)"
  lane :deploy_production do
    assert_no_direct_production!
    sh "cd .. && flutter build appbundle --flavor production -t lib/main_production.dart --release"

    properties = load_flutter_properties
    ensure_changelog(properties['flutter.versionName'] || '1.0',
                     properties['flutter.versionCode'] || '1')

    upload_to_play_store(
      track: 'production',
      package_name: PACKAGE_NAME,
      aab: production_aab_absolute_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Deploy internal build to internal testing"
  lane :deploy_internal do
    sh "cd .. && flutter build appbundle --flavor production -t lib/main_production.dart --release"

    properties = load_flutter_properties
    ensure_changelog(properties['flutter.versionName'] || '1.0',
                     properties['flutter.versionCode'] || '1')

    upload_to_play_store(
      track: 'internal',
      package_name: PACKAGE_NAME,
      aab: production_aab_absolute_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload existing production AAB to internal testing (CI path)"
  lane :upload_internal_aab do
    UI.user_error!("AAB not found at #{production_aab_absolute_path}. Build it first.") unless File.exist?(production_aab_absolute_path)

    properties = load_flutter_properties
    version_name = properties['flutter.versionName'] || '1.0'
    version_code = required_version_code

    assert_version_code_higher!(version_code)
    ensure_changelog(version_name, version_code)

    upload_to_play_store(
      track: 'internal',
      package_name: PACKAGE_NAME,
      aab: production_aab_absolute_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload existing production AAB to production track (DISABLED)"
  lane :upload_production_aab do
    assert_no_direct_production!
    UI.user_error!("AAB not found at #{production_aab_absolute_path}. Build it first.") unless File.exist?(production_aab_absolute_path)

    properties = load_flutter_properties
    ensure_changelog(properties['flutter.versionName'] || '1.0',
                     properties['flutter.versionCode'] || '1')

    upload_to_play_store(
      track: 'production',
      package_name: PACKAGE_NAME,
      aab: production_aab_absolute_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote a TESTED internal release to production with listing metadata and screenshots"
  lane :promote_internal_to_production do
    version_code = (ENV["VERSION_CODE"] || "").strip
    UI.user_error!("VERSION_CODE is required: pin the exact internal build you tested.") if version_code.empty?
    unless version_code.match?(/\A\d+\z/) && version_code.to_i.positive?
      UI.user_error!("VERSION_CODE must be a positive integer, got '#{version_code}'.")
    end
    version_code = version_code.to_i

    properties = load_flutter_properties
    version_name = properties['flutter.versionName'] || '1.0'

    published = play_track_version_codes
    internal_codes = published.fetch('internal', [])
    unless internal_codes.include?(version_code)
      UI.user_error!(<<~MSG)
        versionCode #{version_code} is not on the INTERNAL track.
        Internal holds: #{internal_codes.empty? ? '(none)' : internal_codes.join(', ')}.

        Only a build that has already been uploaded to, and tested on, internal
        may be promoted. Deploy it first, then re-run this lane.
      MSG
    end

    highest = published.values.flatten.max || 0
    production_codes = published.fetch('production', [])
    if production_codes.include?(version_code)
      UI.user_error!("versionCode #{version_code} is already on production. Nothing to promote.")
    end
    UI.message "Highest published versionCode is #{highest}; promoting #{version_code} from internal."

    # Changelogs are generated locally from android/release_notes_<name>.txt.
    # They must exist before supply uploads the metadata directory.
    ensure_changelog(version_name, version_code)
    verify_store_metadata!

    upload_to_play_store(
      package_name: PACKAGE_NAME,
      track: 'internal',
      track_promote_to: 'production',
      version_code: version_code,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      metadata_path: metadata_root,
    )

    UI.success "Promoted internal versionCode #{version_code} to production with listing metadata and screenshots."
  end
end
