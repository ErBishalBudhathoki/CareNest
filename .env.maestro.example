# CareNest Maestro E2E — environment template
# ---------------------------------------------------------------------------
# Copy to `.env.maestro` (gitignored) and fill in values locally. NEVER commit
# real credentials. The runner at scripts/run_maestro.sh loads this file and
# forwards every value to Maestro with `-e KEY=VALUE`.
#
#   cp .env.maestro.example .env.maestro
#   ./scripts/run_maestro.sh --check
#   ./scripts/run_maestro.sh 01_auth_rbac.yaml
#
# No Maestro flow may contain a literal email, password, org code or URL.
# All values below are intentionally blank.

# --- Android application under test ---------------------------------------
# Use the development flavor for E2E; production flavor only for release smoke.
APP_ID=

# --- Login identities (one per role) ---------------------------------------
MAESTRO_ADMIN_USER=
MAESTRO_ADMIN_PASS=
MAESTRO_EMP_USER=
MAESTRO_EMP_PASS=
MAESTRO_CLIENT_USER=
MAESTRO_CLIENT_PASS=

# --- Organization join code used by employee signup flows ------------------
MAESTRO_ORG_CODE=

# --- Backend base URL ------------------------------------------------------
# Provisioned for deep-link / API health preflight flows. No current Maestro
# flow hardcodes a URL; this keeps the target environment explicit and testable.
# Must point at the same environment as APP_ID (dev app -> dev API).
API_BASE_URL=

# --- Seeded test data identities (created by the bulk-* flows) -------------
MAESTRO_SEED_CLIENT_1=
MAESTRO_SEED_CLIENT_2=
MAESTRO_SEED_CLIENT_3=
MAESTRO_SEED_BUSINESS_1=
MAESTRO_SEED_BUSINESS_2=
MAESTRO_SEED_BUSINESS_3=
MAESTRO_SEED_EMPLOYEE_2=
MAESTRO_SEED_EMPLOYEE_3=
