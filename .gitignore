# Test files
*.test.js
test*.js
*_test.js
*.spec.js
# Overrides the `test/` entry under "User-specified ignores" above, and the
# global `*_test.dart` rule, both of which ignored the whole Dart test suite.
# Git cannot descend into an excluded directory and the last matching rule
# wins, so order matters: re-include every .dart under test/, then exclude the
# generated mockito artefacts again.
!test/
!test/**/*.dart
test/**/*.mocks.dart
check_test_user.js
update_test_user.js

