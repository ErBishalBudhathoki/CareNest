# ==============================================================================
# SINGLE SOURCE OF TRUTH FOR iOS DEPLOYMENT TARGET
# Change MIN_IOS_VERSION here; it automatically syncs to:
#   1. CocoaPods platform (:ios, MIN_IOS_VERSION)
#   2. All Pod targets (IPHONEOS_DEPLOYMENT_TARGET in post_install)
#   3. Runner.xcodeproj (project & all target configurations)
#   4. ios/Flutter/AppFrameworkInfo.plist (MinimumOSVersion)
# ==============================================================================
MIN_IOS_VERSION = '16.0'

def sync_ios_deployment_target(target_version)
  # 1. Sync AppFrameworkInfo.plist
  plist_path = File.expand_path('Flutter/AppFrameworkInfo.plist', __dir__)
  if File.exist?(plist_path)
    content = File.read(plist_path)
    new_content = content.gsub(
      /<key>MinimumOSVersion<\/key>\s*<string>[^<]*<\/string>/,
      "<key>MinimumOSVersion</key>\n\t<string>#{target_version}</string>"
    )
    File.write(plist_path, new_content) if content != new_content
  end

  # 2. Sync Runner.xcodeproj
  project_path = File.expand_path('Runner.xcodeproj', __dir__)
  if File.exist?(project_path)
    require 'xcodeproj'
    project = Xcodeproj::Project.open(project_path)
    modified = false

    project.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] != target_version
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = target_version
        modified = true
      end
    end

    project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] != target_version
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = target_version
          modified = true
        end
      end
    end

    project.save if modified
  end
end

sync_ios_deployment_target(MIN_IOS_VERSION)

platform :ios, MIN_IOS_VERSION
use_frameworks!

# Disable CocoaPods analytics to improve build latency
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Firebase dependencies
# pod 'Firebase', '~> 11.4.0'
# Firebase dependencies are managed by Flutter plugins. Do not specify manually unless required.

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Script to read .env and generate Env.xcconfig
pre_install do |installer|
  env_file = File.join(File.dirname(__FILE__), '..', '.env')
  xcconfig_file = File.join(File.dirname(__FILE__), 'Flutter', 'Env.xcconfig')
  
  if File.exist?(env_file)
    env_content = File.read(env_file)
    ios_key = env_content[/GOOGLE_MAPS_API_KEY_FOR_IOS=(.*)/, 1]
    
    if ios_key
      File.open(xcconfig_file, 'w') do |file|
        file.write("GOOGLE_MAPS_API_KEY_FOR_IOS=#{ios_key.strip}\n")
      end
    end
  end
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Install all Flutter pods
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Additional pods or configurations can be added here
end

post_install do |installer|
  # Remove the -G flag from all targets
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['OTHER_CFLAGS'] ||= ['$(inherited)']
    config.build_settings['OTHER_CFLAGS'] = config.build_settings['OTHER_CFLAGS'].reject { |f| f == '-G' }
    config.build_settings['OTHER_CXXFLAGS'] ||= ['$(inherited)']
    config.build_settings['OTHER_CXXFLAGS'] = config.build_settings['OTHER_CXXFLAGS'].reject { |f| f == '-G' }
  end

  # Apply Flutter-specific build settings to all targets
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Force the minimum iOS version for all pod targets
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = MIN_IOS_VERSION
      # Apple Silicon simulators require arm64; the old exclusion breaks local runs.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'

      # Special handling for BoringSSL-GRPC
      if target.name == 'BoringSSL-GRPC'
        config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
        config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '1'
      end
    end
  end
end
